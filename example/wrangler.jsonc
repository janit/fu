// What celld deploys. `fu build` writes .output; this file is the app's own,
// and fu never writes one.
{
  "name": "fu-example",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // The client files go through the Worker, which serves them with the
    // year-long cache header and refuses anything else under /_fu/.
    "run_worker_first": ["/_fu/*"]
  }
}
