{
  "workspace": [
    "./example"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact@^11.0.0",
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "preact": "npm:preact@^11.0.0",
    "preact-render-to-string": "npm:preact-render-to-string@^6.8.0",
    "@preact/signals": "npm:@preact/signals@^2.11.3",
    "urlpattern-polyfill": "npm:urlpattern-polyfill@^10.1.0",
    "rolldown": "npm:rolldown@^1.2.12",
    "rolldown/experimental": "npm:rolldown@^1.2.12/experimental",
    "lightningcss": "npm:lightningcss@^1.33.0",
    "nitro/builder": "npm:nitro@^3.0.260903-beta/builder",
    "crossws/server": "npm:crossws@^0.4.12/server",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "exclude": [
    "**/.fu/",
    "**/.output/",
    "**/dist/",
    "**/node_modules/",
    "**/*.md"
  ],
  "tasks": {
    "dev": "deno run -A --node-modules-dir=manual src/cli.ts dev example",
    "build": "deno run -A --node-modules-dir=manual src/cli.ts build example",
    "check": "deno fmt --check && deno lint && deno check && deno test -A --node-modules-dir=manual",
    "test": "deno test -A --node-modules-dir=manual"
  },
  "nodeModulesDir": "manual",
  "fmt": {
    "lineWidth": 100
  }
}
